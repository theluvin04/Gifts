# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Domain production của Dearly.
APP_URL="https://YOUR_DEARLY_DOMAIN"

# Gmail dùng để gửi email xác nhận đơn.
GMAIL_USER="dearlygifts.team@gmail.com"

# App Password 16 ký tự từ Google Account > Security > App passwords.
# Không dùng mật khẩu Gmail thường.
GMAIL_APP_PASSWORD="xxxxxxxxxxxxxxxx"

# Tên người gửi khách nhìn thấy.
GMAIL_FROM_NAME="Dearly"
