rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function hasEmail() {
      return request.auth != null
        && request.auth.token.email != null;
    }

    function emailAdminExists() {
      return hasEmail()
        && exists(
          /databases/$(database)/documents/admins/$(request.auth.token.email)
        )
        && get(
          /databases/$(database)/documents/admins/$(request.auth.token.email)
        ).data.get('enabled', false) == true;
    }

    function lowerEmailAdminExists() {
      return hasEmail()
        && exists(
          /databases/$(database)/documents/admins/$(request.auth.token.email.lower())
        )
        && get(
          /databases/$(database)/documents/admins/$(request.auth.token.email.lower())
        ).data.get('enabled', false) == true;
    }

    function uidAdminExists() {
      return request.auth != null
        && exists(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        ).data.get('enabled', false) == true;
    }

    function isAdmin() {
      return request.auth != null
        && (
          emailAdminExists()
          || lowerEmailAdminExists()
          || uidAdminExists()
        );
    }

    match /admins/{adminKey} {
      allow get: if request.auth != null
        && (
          request.auth.uid == adminKey
          || (
            hasEmail()
            && (
              request.auth.token.email == adminKey
              || request.auth.token.email.lower() == adminKey
            )
          )
          || isAdmin()
        );

      allow list: if isAdmin();

      // Admin allowlist is managed from Firebase Console,
      // never from browser code.
      allow create, update, delete: if false;
    }

    match /templates/{templateId} {
      // Storefront reads a single template document.
      allow get: if true;

      // Storefront lists only templates that are actually on sale.
      // Client query MUST include where('status', '==', 'available').
      // `visible` remains only for backward compatibility and is not
      // allowed to disagree with the sale state anymore.
      allow list: if isAdmin()
        || resource.data.get('status', '') == 'available';

      // Price / sale / status are Admin-only writes.
      allow create, update, delete: if isAdmin();
    }

    match /assetLibrary/{assetId} {
      // Asset metadata is only needed inside Admin.
      // Public templates use the final Storage download URL.
      allow get, list, create, update, delete: if isAdmin();
    }

    match /assetFolders/{folderId} {
      allow get, list, create, update, delete: if isAdmin();
    }

    match /orderCodes/{orderNumber} {
      // Anonymous checkout may only CLAIM a brand-new 4-digit code.
      // Existing documents cannot be overwritten, so collisions retry.
      allow create: if request.auth != null
        && orderNumber.matches('^[0-9]{4}$')
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.orderNumber == orderNumber
        && request.resource.data.orderCode == 'Dearly' + orderNumber
        && request.resource.data.giftId is string;

      allow get, list: if isAdmin();

      // Reservation documents are immutable. Even Admin checkout tests
      // must not be able to overwrite a code that is already claimed.
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /orderLookupRecords/{lookupId} {
      function validPublicLookup() {
        return request.resource.data.keys().hasOnly([
            'orderCode',
            'orderCodeLower',
            'phoneHash',
            'templateId',
            'templateName',
            'paymentStatus',
            'status',
            'price',
            'currency',
            'createdAtMs',
            'updatedAtMs'
          ])
          && request.resource.data.orderCode is string
          && request.resource.data.orderCode.matches('^Dearly[0-9]{4}$')
          && request.resource.data.orderCodeLower
            == request.resource.data.orderCode.lower()
          && request.resource.data.phoneHash is string
          && request.resource.data.phoneHash.matches('^[a-f0-9]{64}$')
          && request.resource.data.templateId is string
          && request.resource.data.templateName is string
          && request.resource.data.paymentStatus is string
          && request.resource.data.status is string
          && request.resource.data.price is number
          && request.resource.data.price >= 0
          && request.resource.data.currency == 'VND'
          && request.resource.data.createdAtMs is number
          && request.resource.data.updatedAtMs is number;
      }

      // Public tracking may read one exact lookup document only.
      // Collection listing/search is Admin-only, so a visitor must know
      // BOTH the order code and phone number to derive the document id.
      allow get: if true;
      allow list: if isAdmin();

      // Customer browser can only create the initial
      // waiting-payment lookup record.
      allow create: if isAdmin()
        || (
          request.auth != null
          && validPublicLookup()
          && request.resource.data.paymentStatus
            == 'waiting_bank_transfer'
          && request.resource.data.status == 'draft'
        );

      // Status changes are Admin-only and must keep a valid public shape.
      allow update: if isAdmin()
        && validPublicLookup();

      // On delete, request.resource does not exist.
      // Calling validPublicLookup() here would reject every Admin delete.
      allow delete: if isAdmin();
    }

    match /gifts/{giftId} {
      function isOwner() {
        return request.auth != null
          && resource != null
          && resource.data.get('creatorId', '') == request.auth.uid;
      }

      function isPublished() {
        return resource != null
          && (
            resource.data.get('status', '') == 'published'
            || resource.data.get('isPublished', false) == true
          );
      }

      function isSafeCustomerPaymentStatus(value) {
        return value == 'unpaid'
          || value == 'waiting_bank_transfer';
      }

      function validCustomerCreate() {
        return request.auth != null
          && request.resource.data.config != null
          && request.resource.data.creatorId == request.auth.uid
          && request.resource.data.get('status', '') == 'draft'
          && request.resource.data.get('isPublished', false) == false
          && isSafeCustomerPaymentStatus(
            request.resource.data.get('paymentStatus', 'unpaid')
          )
          && !request.resource.data.keys().hasAny([
            'paidAt',
            'publishedAt'
          ]);
      }

      function validCustomerDraftUpdate() {
        return isOwner()
          && resource.data.get('status', 'draft') == 'draft'
          && resource.data.get('isPublished', false) == false
          && isSafeCustomerPaymentStatus(
            resource.data.get('paymentStatus', 'unpaid')
          )
          && request.resource.data.config != null
          && request.resource.data.get('creatorId', '')
            == resource.data.get('creatorId', '')
          && request.resource.data.get('status', 'draft') == 'draft'
          && request.resource.data.get('isPublished', false) == false
          && request.resource.data.get('paymentStatus', 'unpaid')
            == resource.data.get('paymentStatus', 'unpaid')
          && request.resource.data.get('templateId', '')
            == resource.data.get('templateId', '')
          && request.resource.data.get('price', 0)
            == resource.data.get('price', 0)
          && request.resource.data.get('currency', '')
            == resource.data.get('currency', '')
          && request.resource.data.get('orderNumber', '')
            == resource.data.get('orderNumber', '')
          && request.resource.data.get('orderCode', '')
            == resource.data.get('orderCode', '')
          && request.resource.data.get('paymentReference', '')
            == resource.data.get('paymentReference', '')
          && !request.resource.data.keys().hasAny([
            'paidAt',
            'publishedAt'
          ]);
      }

      // Needed because checkout probes a custom gift ID
      // before creating it.
      allow get: if resource == null
        || isPublished()
        || isOwner()
        || isAdmin();

      allow list: if isAdmin();

      // Customer can only create an unpublished draft.
      // Paid/published gifts can only be created directly by Admin.
      allow create: if isAdmin()
        || validCustomerCreate();

      // Customer may keep editing their own unpaid draft, but cannot
      // change payment, price, order identity or publication state.
      allow update: if isAdmin()
        || validCustomerDraftUpdate();

      // Once a gift is paid/published, only Admin may delete it.
      allow delete: if isAdmin()
        || (
          isOwner()
          && resource.data.get('status', 'draft') == 'draft'
          && resource.data.get('isPublished', false) == false
          && isSafeCustomerPaymentStatus(
            resource.data.get('paymentStatus', 'unpaid')
          )
        );
    }
  }
}
