rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isGoogleUser() {
      return request.auth != null
        && request.auth.token.email != null;
    }

    function isAdmin() {
      return request.auth != null
        && (
          (
            request.auth.token.email != null
            && (
              (
                exists(/databases/$(database)/documents/admins/$(request.auth.token.email))
                && get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.get('enabled', false) == true
              )
              || (
                exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()))
                && get(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())).data.get('enabled', false) == true
              )
            )
          )
          || (
            exists(/databases/$(database)/documents/admins/$(request.auth.uid))
            && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('enabled', false) == true
          )
        );
    }

    match /admins/{adminKey} {
      // Cho user đọc document admin của chính email/UID mình
      allow get: if request.auth != null
        && (
          (
            request.auth.token.email != null
            && (
              request.auth.token.email == adminKey
              || request.auth.token.email.lower() == adminKey.lower()
            )
          )
          || request.auth.uid == adminKey
          || isAdmin()
        );

      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /gifts/{giftId} {
      function isOwner() {
        return request.auth != null
          && resource != null
          && resource.data.get('creatorId', '') == request.auth.uid;
      }

      function isPublished() {
        return resource != null
          && (
            resource.data.get('status', '') == 'published'
            || resource.data.get('isPublished', false) == true
          );
      }

      function validWrite() {
        return request.auth != null
          && request.resource.data.config != null
          && (
            request.resource.data.creatorId == request.auth.uid
            || isAdmin()
          );
      }

      // Cho phép get nếu document chưa tồn tại (trả về snapshot.exists = false),
      // hoặc đã published, hoặc người tạo đang xem, hoặc admin đang xem.
      allow get: if resource == null
        || isPublished()
        || isOwner()
        || isAdmin();

      // Chỉ admin được list/query danh sách gifts
      allow list: if isAdmin();

      allow create: if validWrite();

      allow update: if (isOwner() || isAdmin())
        && validWrite();

      allow delete: if isOwner()
        || isAdmin();
    }
  }
}

