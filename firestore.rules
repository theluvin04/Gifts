rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isGoogleUser() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isAdmin() {
      return isGoogleUser()
        && exists(
          /databases/$(database)/documents/admins/$(request.auth.token.email)
        )
        && get(
          /databases/$(database)/documents/admins/$(request.auth.token.email)
        ).data.enabled == true;
    }

    match /admins/{adminEmail} {
      // Google user chỉ được đọc record mang đúng Gmail của mình.
      allow get: if isGoogleUser()
        && request.auth.token.email == adminEmail;

      // Admin records chỉ tạo/sửa trực tiếp từ Firebase Console.
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /gifts/{giftId} {
      function isOwner() {
        return request.auth != null
          && resource.data.creatorId == request.auth.uid;
      }

      function isPublished() {
        return resource.data.status == 'published'
          || resource.data.isPublished == true;
      }

      function validWrite() {
        return request.auth != null
          && request.resource.data.config != null
          && request.resource.data.creatorId == request.auth.uid
          && (
            request.resource.data.status == 'draft'
            || request.resource.data.status == 'published'
          )
          && request.resource.data.isPublished
            == (
              request.resource.data.status == 'published'
            );
      }

      // Public chỉ get gift published.
      // Creator đọc gift của mình.
      // Google Admin đọc được tất cả.
      allow get: if isPublished()
        || isOwner()
        || isAdmin();

      // Chỉ Google Admin query toàn bộ collection gifts.
      allow list: if isAdmin();

      allow create: if validWrite();

      allow update: if isOwner()
        && request.resource.data.creatorId
          == resource.data.creatorId
        && validWrite();

      allow delete: if isOwner()
        || isAdmin();
    }
  }
}
